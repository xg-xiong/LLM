Screen {
    layout: vertical;
    background: #121212;
    color: #e0e0e0;
}

#top-bar {
    width: 1fr;
    height: 1;
    padding: 0 2;
    background: #242f38;
    color: #a0a3a6;
}

#top-title {
    width: 1fr;
    height: 1;
    color: #c7cacc;
    text-align: center;
    text-style: bold;
}

#top-context {
    width: auto;
    height: 1;
    padding: 0 2;
    text-align: right;
    text-style: bold;
}

#top-context.context-ok {
    color: #9ecb9e;
}

#top-context.context-warn {
    color: #ffa62b;
}

#top-clock {
    width: 10;
    height: 1;
    color: #a0a3a6;
    text-align: right;
}

#body {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
    background: #121212;
}

#body.sidebar-hidden #sidebar {
    width: 0;
    display: none;
}

#main-pane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
    background: #121212;
}

#chat-frame {
    width: 1fr;
    height: 1fr;
    background: #121212;
}

#chat {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
    background: #121212;
    scrollbar-size-vertical: 1;
    scrollbar-background: #121212;
    scrollbar-color: #464848 55%;
    scrollbar-color-hover: #6f7872 80%;
    scrollbar-color-active: #ffa62b;
}

.welcome-card {
    width: 1fr;
    height: auto;
    margin: 0 0 1 0;
    padding: 1 2;
    background: #181a1b;
    border: round #ffa62b;
    border-title-color: #ffa62b;
    border-title-background: #181a1b;
    border-title-style: bold;
    border-title-align: left;
}

.welcome-brand {
    width: 1fr;
    height: 1;
    color: #f0f0f0;
    text-style: bold;
}

.welcome-copy {
    width: 1fr;
    height: auto;
    color: #a0a3a6;
}

.welcome-gap {
    width: 1fr;
    height: 1;
}

.welcome-meta-row {
    width: 1fr;
    height: 1;
}

.welcome-label {
    width: 6;
    height: 1;
    color: #6c6c6c;
}

.welcome-value {
    width: 1fr;
    height: 1;
    color: #d0d0d0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.welcome-tip {
    width: 1fr;
    height: 1;
    color: #6c6c6c;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.message-row {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
}

.message-card {
    width: 1fr;
    height: auto;
}

.card-user {
    padding: 1 2;
    background: #1e1e1e;
    border-left: solid #ffa62b;
}

.card-assistant {
    padding: 0;
    background: transparent;
    border: none;
}

.card-tool {
    padding: 1 2;
    background: #1e1e1e;
    border-left: solid #6f7872;
}

.card-error {
    padding: 1 2;
    background: #1e1e1e;
    border-left: solid #c45a5a;
}

.card-warning {
    padding: 1 2;
    background: #1e1e1e;
    border-left: solid #ffa62b;
}

.card-system {
    padding: 0;
    background: transparent;
    border: none;
}

.message-role {
    width: 1fr;
    height: 1;
    text-style: bold;
}

.role-assistant {
    color: #a0a0a0;
}

.role-tool {
    color: #a0a3a6;
}

.role-error {
    color: #e08a8a;
}

.role-warning {
    color: #ffa62b;
}

.message-body {
    width: 1fr;
    height: auto;
    color: #e0e0e0;
}

.body-user,
.body-assistant {
    color: #e0e0e0;
}

.body-tool {
    color: #e0e0e0;
}

.body-error {
    color: #f0b0b0;
}

.body-warning {
    color: #e0c08a;
}

.body-system {
    color: #9e9e9e;
}

.card-system .message-body {
    text-align: center;
}

.tool-ok {
    color: #d8d8d8;
}

.tool-error {
    color: #e8a0a0;
}

#sidebar {
    width: 28;
    min-width: 20;
    height: 1fr;
    padding: 0;
    background: #1e1e1e;
    border-left: solid #20303d;
    scrollbar-size-vertical: 1;
    scrollbar-background: #1e1e1e;
    scrollbar-color: #464848 55%;
    scrollbar-color-hover: #6f7872 80%;
    scrollbar-color-active: #ffa62b;
}

#sidebar-inner {
    width: 1fr;
    height: auto;
    padding: 1 2;
    background: #1e1e1e;
}

.sidebar-tab {
    width: 1fr;
    height: 1;
    color: #e0e0e0;
    text-style: bold;
}

.sidebar-tab.active {
    color: #ffa62b;
}

.side-row {
    width: 1fr;
    height: 1;
}

.side-label {
    width: 5;
    height: 1;
    color: #6c6c6c;
}

.side-value {
    width: 1fr;
    height: 1;
    color: #e0e0e0;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

.side-path {
    color: #a0a3a6;
}

.sidebar-divider {
    width: 1fr;
    height: 1;
    margin: 1 0;
    background: #2a343c;
}

#sidebar-stats {
    width: 1fr;
    height: 1;
}

.side-stat {
    width: auto;
    height: 1;
    padding-right: 2;
    color: #e0e0e0;
    text-style: bold;
}

.side-status {
    width: 1fr;
    height: 1;
    text-align: right;
}

.side-sub {
    width: 1fr;
    height: 1;
    color: #6c6c6c;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#tools-title {
    width: 1fr;
    height: 1;
    margin-bottom: 1;
    color: #9e9e9e;
    text-style: bold;
}

.tool-item {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    padding-left: 1;
    border-left: solid #2a343c;
}

.tool-name {
    width: 1fr;
    height: 1;
    color: #a0a3a6;
}

.tool-desc {
    width: 1fr;
    height: auto;
    color: #6c6c6c;
}

.tool-item.tool-active {
    border-left: thick #ffa62b;
}

.tool-item.tool-active .tool-name {
    color: #ffa62b;
}

.tool-item.tool-done {
    border-left: solid #6f7872;
}

.tool-item.tool-done .tool-name {
    color: #6f7872;
}

.tool-item.tool-error {
    border-left: thick #c45a5a;
}

.tool-item.tool-error .tool-name {
    color: #e08a8a;
}

#composer {
    width: 1fr;
    height: auto;
    min-height: 3;
    margin: 0 1 0 1;
    padding: 1 2;
    background: #1e1e1e;
    border-top: solid #20303d;
}

#composer:focus-within {
    border-top: solid #2a343c;
}

#composer-row {
    width: 1fr;
    height: auto;
}

#prompt-icon {
    width: 2;
    height: 1;
    color: #ffa62b;
    text-style: bold;
    content-align: center middle;
}

#prompt {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 10;
    padding: 0 1;
    border: none;
    background: transparent;
    color: #e0e0e0;
    scrollbar-size-vertical: 1;
    scrollbar-background: #1e1e1e;
    scrollbar-color: #464848 55%;
    scrollbar-color-hover: #6f7872 80%;
    scrollbar-color-active: #ffa62b;
}

#prompt:focus {
    border: none;
    background: transparent;
}

#prompt .text-area--placeholder {
    color: #6c6c6c;
}

#prompt .text-area--cursor {
    background: #ffa62b;
    color: #121212;
}

#bottom-bar {
    width: 1fr;
    height: auto;
    min-height: 2;
    padding: 0 2;
    background: #242f38;
    color: #a0a3a6;
}

#status-row {
    width: 1fr;
    height: 1;
}

#status {
    width: auto;
    height: 1;
    padding-right: 2;
    text-style: bold;
}

.status-idle {
    color: #6f7872;
}

.status-busy {
    color: #ffa62b;
}

.status-warn {
    color: #e08a8a;
}

#turn-stats {
    width: 1fr;
    height: 1;
    color: #6c6c6c;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#esc-hint {
    width: auto;
    height: 1;
    color: #a0a3a6;
    text-align: right;
}

#shortcuts {
    width: 1fr;
    height: 1;
    color: #6c6c6c;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#body.sidebar-hidden #sidebar {
    width: 0;
    display: none;
}

CompactionScreen {
    align: center middle;
    background: #000000 70%;
}

#compact-dialog {
    width: 92%;
    height: 86%;
    padding: 1 2;
    background: #181a1b;
    border: round #ffa62b;
}

#compact-title {
    width: 1fr;
    height: 1;
    color: #ffa62b;
    text-style: bold;
}

#compact-columns {
    width: 1fr;
    height: 1fr;
    margin-top: 1;
}

.compact-column {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}

.compact-heading {
    width: 1fr;
    height: 1;
    color: #a0a3a6;
    text-style: bold;
}

.compact-scroll {
    width: 1fr;
    height: 1fr;
    margin-top: 1;
    padding: 0 1;
    background: #121212;
    border: solid #2a343c;
    scrollbar-size-vertical: 1;
    scrollbar-background: #121212;
    scrollbar-color: #464848 55%;
    scrollbar-color-hover: #6f7872 80%;
    scrollbar-color-active: #ffa62b;
}

.compact-text {
    width: 1fr;
    height: auto;
    color: #e0e0e0;
}

#compact-close {
    width: 12;
    height: 3;
    margin-top: 1;
    align-horizontal: center;
}

#slash-menu {
    display: none;
    width: 1fr;
    height: auto;
    max-height: 14;
    margin-bottom: 1;
    padding: 0 1;
    background: #181a1b;
    border: round #2a343c;
    scrollbar-size-vertical: 1;
    scrollbar-background: #181a1b;
    scrollbar-color: #464848 55%;
}

#slash-menu.visible {
    display: block;
}

#slash-menu-body {
    width: 1fr;
    height: auto;
    color: #d8d8d8;
}

#mcp-list {
    width: 1fr;
    height: auto;
}

.mcp-item {
    width: 1fr;
    height: auto;
    margin-bottom: 1;
    padding-left: 1;
    border-left: solid #2a343c;
}

.mcp-name {
    width: 1fr;
    height: 1;
    color: #a0a3a6;
}

.mcp-state {
    width: 1fr;
    height: auto;
    color: #6c6c6c;
}

.mcp-item.mcp-connecting {
    border-left: thick #ffa62b;
}

.mcp-item.mcp-connecting .mcp-state {
    color: #ffa62b;
}

.mcp-item.mcp-connected {
    border-left: solid #6f7872;
}

.mcp-item.mcp-connected .mcp-state {
    color: #9ecb9e;
}

.mcp-item.mcp-error {
    border-left: thick #c45a5a;
}

.mcp-item.mcp-error .mcp-state {
    color: #e08a8a;
}

SessionPickerScreen,
ConfigCreatedScreen {
    align: center middle;
    background: #000000 70%;
}

#resume-dialog {
    width: 78%;
    height: 72%;
    padding: 1 2;
    background: #181a1b;
    border: round #ffa62b;
}

#resume-title,
#config-created-title {
    width: 1fr;
    height: 1;
    color: #ffa62b;
    text-style: bold;
}

.resume-hint {
    width: 1fr;
    height: auto;
    margin: 1 0;
    color: #9e9e9e;
}

#session-list {
    width: 1fr;
    height: 1fr;
    margin-top: 1;
    background: #121212;
    border: solid #2a343c;
    scrollbar-size-vertical: 1;
    scrollbar-background: #121212;
    scrollbar-color: #464848 55%;
}

#resume-actions {
    width: 1fr;
    height: auto;
    align-horizontal: right;
}

#resume-cancel {
    width: 12;
    height: 3;
}

#session-empty {
    width: 1fr;
    height: auto;
    margin-top: 2;
    color: #9e9e9e;
}

#config-created-dialog {
    width: 72%;
    height: auto;
    padding: 1 2;
    background: #181a1b;
    border: round #ffa62b;
}

#config-created-text {
    width: 1fr;
    height: auto;
    margin: 1 0;
    color: #e0e0e0;
}

#config-created-close {
    width: 12;
    height: 3;
    align-horizontal: center;
}
